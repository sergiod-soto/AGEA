# ─────────────────────────────────────────────────────────────
#  Configuración LOCAL — no subir a git
# ─────────────────────────────────────────────────────────────

# Raíz de imports Python
PYTHONPATH=D:\AGEA\python

# ── Grid ──────────────────────────────────────────────────────
SECTOR_SIZE=10000

# ── Sectores ──────────────────────────────────────────────────
SECTOR_HOST=localhost
SECTOR_BASE_PORT=40100
FALLOS_CONSECUTIVOS_SECTOR_CAIDO=3



# ── Gestor Mundo ──────────────────────────────────────────────
GESTOR_MUNDO_HOST=localhost
GESTOR_MUNDO_PORT=40200
GESTOR_MUNDO_WORKERS=4
TICK_TIMEOUT_MS=500
TICKS_ANTES_DE_DORMIR=10
UNITY_FRAME_EVERY_N_TICKS=1
SNAPSHOT_INTERVAL_TICKS=100
DEEP_SAVE_INTERVAL_TICKS=500
SNAPSHOT_DIR=D:\AGEA\python\data\snapshots
MAX_VISION_DISTANCE=50
SOUND_MAP_CELL_SIZE=10

# ── Gestor Bots ───────────────────────────────────────────────
GESTOR_BOTS_HOST=localhost
GESTOR_BOTS_PORT=40051
GESTOR_BOTS_ADDRESS=localhost:40051

# ── Hypervisores ──────────────────────────────────────────────
HYPERVISOR_HOST=localhost
HYPERVISOR_BASE_PORT=40300
HYPERVISOR_PROXY_BASE_PORT=40400
HYPERVISOR_COUNT=1
UMBRAL_HV_CAIDO_SEGUNDOS=90

# ── Log ──────────────────────────────────────────────
LOG_SERVER_ADDRESS=